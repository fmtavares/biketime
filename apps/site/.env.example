# =============================================================================
# BikeTime (site institucional) — copie para .env e preencha
# Dashboard: https://supabase.com/dashboard/project/zzgfyksiktejlyenasvo
#
# Na Vercel: Project Settings → Environment Variables (mesmas chaves abaixo)
# Nunca commite o arquivo .env
# =============================================================================

# --- Cliente (browser) — prefixo VITE_ é obrigatório ---
VITE_SUPABASE_URL=https://zzgfyksiktejlyenasvo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_anon_ou_publishable_key
VITE_SUPABASE_PROJECT_ID=zzgfyksiktejlyenasvo

# --- Servidor (SSR / server functions) ---
SUPABASE_URL=https://zzgfyksiktejlyenasvo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_anon_ou_publishable_key
SUPABASE_PROJECT_ID=zzgfyksiktejlyenasvo

# Service role — só servidor, nunca com prefixo VITE_
# Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# --- Opcional: chat Sprint ---
# OPENAI_API_KEY=
# OPENAI_ASSISTANT_ID=

# --- QR adesivo bike: redirect staff para a gestão ---
# GESTAO_URL=https://gestao.biketime.com.br

