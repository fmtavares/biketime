{
  "name": "biketime",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:site": "npm run dev -w @biketime/site",
    "dev:gestao": "npm run dev -w @biketime/gestao",
    "build:site": "npm run build -w @biketime/site",
    "build:gestao": "npm run build -w @biketime/gestao",
    "lint": "npm run lint -w @biketime/site && npm run lint -w @biketime/gestao"
  },
  "overrides": {
    "@tanstack/react-start": "1.168.61",
    "@tanstack/start-server-core": "1.169.40",
    "@tanstack/react-start-server": "1.167.47",
    "@tanstack/react-start-client": "1.168.40",
    "@tanstack/react-start-rsc": "0.1.60",
    "@tanstack/start-plugin-core": "1.171.50"
  }
}
